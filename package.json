{
  "name": "@snz/sttc",
  "version": "0.1.0",
  "sttc": {
    "projectFormatVersion": "2.0.0"
  },
  "description": "HTML-first, Bun-native static site builder for STTC sites.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanitizestudio/sttc.git"
  },
  "homepage": "https://sttc.snz.st",
  "bugs": {
    "url": "https://github.com/sanitizestudio/sttc/issues"
  },
  "keywords": [
    "bun",
    "static-site",
    "html",
    "seo",
    "llms"
  ],
  "files": [
    "AGENTS.md",
    "README.md",
    "framework/build/",
    "framework/cli/",
    "framework/dev.ts",
    "framework/docs/",
    "framework/runtime/",
    "framework/types/",
    "templates/default/"
  ],
  "workspaces": [
    "templates/default"
  ],
  "bin": {
    "sttc": "./framework/cli/sttc.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun framework/cli/sttc.ts build",
    "check": "bun framework/cli/sttc.ts check",
    "typecheck": "tsc --noEmit",
    "dev": "bun framework/cli/sttc.ts dev",
    "doctor": "bun run typecheck && bun framework/cli/sttc.ts doctor",
    "framework:verify": "bun run doctor && bun test framework/tests && bun run smoke:create",
    "test": "bun test framework/tests",
    "new": "bun framework/cli/sttc.ts new",
    "skills": "bun framework/cli/sttc.ts skills",
    "migrate": "bun framework/cli/sttc.ts migrate",
    "check:private": "bun framework/scripts/private-review-guard.ts",
    "smoke:create": "bun framework/scripts/smoke-create.ts"
  }
}
