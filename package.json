{
  "name": "@snz/bp",
  "version": "0.1.0",
  "description": "HTML-first, Bun-native static site builder for SANITIZE Boilerplate sites.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanitizestudio/snz-bp.git"
  },
  "homepage": "https://github.com/sanitizestudio/snz-bp#readme",
  "bugs": {
    "url": "https://github.com/sanitizestudio/snz-bp/issues"
  },
  "keywords": [
    "bun",
    "static-site",
    "html",
    "seo",
    "llms"
  ],
  "files": [
    "AGENTS.md",
    "README.md",
    "bin/",
    "build/",
    "dev.ts",
    "docs/",
    "runtime/",
    "templates/default/"
  ],
  "workspaces": [
    "templates/default",
    "packages/create-snz-bp"
  ],
  "bin": {
    "snz-bp": "./bin/snz-bp.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun bin/snz-bp.ts build",
    "check": "bun bin/snz-bp.ts check",
    "css:audit": "bun bin/snz-bp.ts css:audit",
    "dev": "bun bin/snz-bp.ts dev",
    "doctor": "bun bin/snz-bp.ts doctor",
    "test": "bun test",
    "new": "bun bin/snz-bp.ts new",
    "add": "bun bin/snz-bp.ts add",
    "migrate": "bun bin/snz-bp.ts migrate",
    "prepare:create-template": "bun scripts/sync-create-template.ts",
    "check:create-template": "bun scripts/sync-create-template.ts --check",
    "check:private": "bun scripts/private-review-guard.ts",
    "smoke:create": "bun scripts/smoke-create.ts"
  }
}
