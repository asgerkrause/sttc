{
  "name": "@snz/sttc",
  "version": "0.2.0",
  "description": "HTML-first static site renderer for Bun with build-time components, responsive images, and built-in SEO and discovery output.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanitizestudio/sttc.git"
  },
  "homepage": "https://github.com/sanitizestudio/sttc#readme",
  "bugs": {
    "url": "https://github.com/sanitizestudio/sttc/issues"
  },
  "keywords": [
    "bun",
    "static-site-generator",
    "ssg",
    "html",
    "components",
    "seo",
    "json-ld",
    "llms-txt"
  ],
  "files": [
    "AGENTS.md",
    "README.md",
    "framework/build/",
    "framework/cli/",
    "framework/dev.ts",
    "framework/preview.ts",
    "framework/docs/",
    "framework/runtime/",
    "framework/types/",
    "templates/default/"
  ],
  "workspaces": [
    "templates/default"
  ],
  "bin": {
    "sttc": "./framework/cli/sttc.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun framework/cli/sttc.ts build",
    "check": "bun framework/cli/sttc.ts check",
    "typecheck": "tsc --noEmit",
    "dev": "bun framework/cli/sttc.ts dev",
    "preview": "bun framework/cli/sttc.ts preview",
    "doctor": "bun run typecheck && bun framework/cli/sttc.ts doctor",
    "framework:verify": "bun run doctor && bun test framework/tests && bun run smoke:create",
    "test": "bun test framework/tests",
    "new": "bun framework/cli/sttc.ts new",
    "skills": "bun framework/cli/sttc.ts skills",
    "smoke:create": "bun framework/scripts/smoke-create.ts"
  }
}
